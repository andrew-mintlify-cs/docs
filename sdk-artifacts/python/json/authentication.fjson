thentication.users.Users\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Users</span></code></a><ul>\n<li><a class=\"reference internal\" href=\"#auth0.authentication.users.Users.userinfo\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Users.userinfo()</span></code></a></li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "authentication", "sidebars": ["localtoc.html", "relations.html", "sourcelink.html", "searchbox.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "sphinx_version_info": [8, 1, 3, "final", 0], "READTHEDOCS": false}